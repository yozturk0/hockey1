{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hockey",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/server.js"
      ],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "itch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const d=p.join(process.cwd(),'portal/build/itch');h.createServer((q,s)=>{const n=q.url==='/'?'/index.html':q.url.split('?')[0];const t={'.html':'text/html','.js':'text/javascript','.css':'text/css','.svg':'image/svg+xml'}[p.extname(n)]||'application/octet-stream';f.readFile(p.join(d,n),(e,b)=>e?(s.writeHead(404),s.end()):(s.writeHead(200,{'content-type':t}),s.end(b)))}).listen(process.env.PORT||8099,()=>console.log('itch build on 8099'))"
      ],
      "port": 8099,
      "autoPort": true
    }
  ]
}